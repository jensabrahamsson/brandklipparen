# Example environment for Brandklipparen (I-08, M-11).
# This file carries variable names only, with empty value fields.
# Copy nothing secret here: real keys live in the platform secret store
# and reach the runtime solely as environment variables at startup.
# Every name below matches the typed schema validated at startup.

# Environment choice: local, ci or demo.
BRANDKLIPPAREN_ENV=
# Listen port for the REST API and MCP server (local and demo).
BRANDKLIPPAREN_HTTP_PORT=
# Allowlisted RPC endpoints for Ethereum mainnet, comma-separated (secret).
BRANDKLIPPAREN_RPC_URLS=
# Chain ID for Ethereum mainnet, validated against the RPC response.
BRANDKLIPPAREN_CHAIN_ID=
# Version of the calibration artifact the core loads.
BRANDKLIPPAREN_MODEL_VERSION=
# Path inside the repo to model/artifact-<version>.json.
BRANDKLIPPAREN_MODEL_ARTIFACT_PATH=
# Version of the clone index.
BRANDKLIPPAREN_CLONE_INDEX_VERSION=
# Time limit per decompilation in milliseconds.
BRANDKLIPPAREN_extdecomp_DEADLINE_MS=
# Memory limit per extdecomp worker in megabytes.
BRANDKLIPPAREN_extdecomp_MAX_MEMORY_MB=
# Size limit for decompiled output in bytes.
BRANDKLIPPAREN_extdecomp_MAX_OUTPUT_BYTES=
# Number of parallel extdecomp workers (demo).
BRANDKLIPPAREN_extdecomp_MAX_CONCURRENCY=
# Path to the decompiler executable (the pinned extdecomp binary in the demo).
BRANDKLIPPAREN_extdecomp_BINARY_PATH=
# Time limit per RPC call in milliseconds (demo).
BRANDKLIPPAREN_RPC_DEADLINE_MS=
# Parallel RPC calls (demo).
BRANDKLIPPAREN_RPC_MAX_CONCURRENCY=
# Retries with backoff per RPC call (demo).
BRANDKLIPPAREN_RPC_RETRY_BUDGET=
# Size limit for RPC responses in bytes (demo).
BRANDKLIPPAREN_RPC_MAX_RESPONSE_BYTES=
# Maximum proxy chain depth to follow during proxy resolution.
BRANDKLIPPAREN_PROXY_MAX_DEPTH=
# Time limit per assessment call in milliseconds, both providers (demo).
BRANDKLIPPAREN_ASSESSMENT_DEADLINE_MS=
# Input size limit per assessment call in bytes, both providers (demo).
BRANDKLIPPAREN_ASSESSMENT_MAX_INPUT_BYTES=
# Output size limit per assessment call in bytes, both providers (demo).
BRANDKLIPPAREN_ASSESSMENT_MAX_OUTPUT_BYTES=
# Parallel assessment calls, both providers (demo).
BRANDKLIPPAREN_ASSESSMENT_MAX_CONCURRENCY=
# Canonical public demo URL (demo).
BRANDKLIPPAREN_DEMO_PUBLIC_URL=
# Directory or volume for the cache per code hash (local and demo).
BRANDKLIPPAREN_CACHE_DIR=
# API keys for the REST API, comma-separated (secret; configure at least
# one key, otherwise the API rejects analysis calls until one exists).
BRANDKLIPPAREN_API_KEYS=
# Secret component in the salted hashing of API keys (secret, demo).
BRANDKLIPPAREN_API_KEY_PEPPER=
# Rate limit per API key per minute (demo). Example: 60.
BRANDKLIPPAREN_RATE_LIMIT_PER_KEY_PER_MINUTE=
# Daily quota per API key (demo). Example: 1000.
BRANDKLIPPAREN_QUOTA_PER_KEY_PER_DAY=
# Global rate limit per minute (demo). Example: 600.
BRANDKLIPPAREN_GLOBAL_RATE_PER_MINUTE=
# Daily cap for RPC calls in the demo (demo).
BRANDKLIPPAREN_BUDGET_DAILY_CAP_RPC_CALLS=
# Daily cap for RPC calls per API key (demo).
BRANDKLIPPAREN_BUDGET_PER_KEY_DAILY_CAP_RPC_CALLS=
# Daily cap for assessment calls for the selected provider (demo).
BRANDKLIPPAREN_BUDGET_DAILY_CAP_ASSESSMENT_CALLS=
# Daily cap for Meta Model API assessment calls (demo with the Meta provider).
BRANDKLIPPAREN_BUDGET_DAILY_CAP_ASSESSMENT_CALLS_META=
# Daily cap for hosted open-weights assessment calls (demo with hosted).
BRANDKLIPPAREN_BUDGET_DAILY_CAP_ASSESSMENT_CALLS_hosted=
# Daily cap for assessment calls per API key, both providers (demo).
BRANDKLIPPAREN_BUDGET_PER_KEY_DAILY_CAP_ASSESSMENT_CALLS=
# Daily cost cap for the Meta Model API provider (demo with Meta).
BRANDKLIPPAREN_ASSESSMENT_DAILY_COST_CAP_META=
# Daily cost cap for the hosted provider (demo with hosted).
BRANDKLIPPAREN_ASSESSMENT_DAILY_COST_CAP_hosted=
# Alarm levels in percent of the daily caps, comma-separated (demo).
BRANDKLIPPAREN_ALARM_LEVELS_PERCENT=
# Log level: debug, info, warn or error.
BRANDKLIPPAREN_LOG_LEVEL=
# Selected assessment provider: meta-model-api or hosted-open-weights (demo).
# Documented default intent is hosted-open-weights with model id
# meta-models/muse-spark-open-1026; Meta is never auto-selected.
# An unset provider, or a selected provider without its API key, leaves the
# feature disabled and the UI and API report not configured.
BRANDKLIPPAREN_ASSESSMENT_PROVIDER=
# Prompt version for the Muse contract assessment (demo).
BRANDKLIPPAREN_ASSESSMENT_PROMPT_VERSION=
# Key for the Meta Model API, server-side only (secret, demo with Meta).
BRANDKLIPPAREN_ASSESSMENT_META_API_KEY=
# Model id for the Meta Model API provider (demo with Meta).
BRANDKLIPPAREN_ASSESSMENT_META_MODEL_ID=
# Allowlisted API root for the Meta Model API (demo with Meta),
# for example ending in /v1; the adapter appends /chat/completions.
BRANDKLIPPAREN_ASSESSMENT_META_BASE_URL=
# Key for hosted, server-side only (secret, demo with hosted).
BRANDKLIPPAREN_ASSESSMENT_hosted_API_KEY=
# Model id for the hosted provider (demo with hosted).
# Documented default: meta-models/muse-spark-open-1026 (Muse Spark Open).
BRANDKLIPPAREN_ASSESSMENT_hosted_MODEL_ID=
# Allowlisted API root for the hosted deployment (demo with hosted),
# for example ending in /v1; the adapter appends /chat/completions.
BRANDKLIPPAREN_ASSESSMENT_hosted_BASE_URL=
# Deployment identifier for the hosted open-weights serving (demo with hosted).
BRANDKLIPPAREN_ASSESSMENT_hosted_DEPLOYMENT_ID=
# Vendor-neutral chat-completions endpoint for local development only
# (temporary local endpoint; the default stays disabled without it).
# Key for the vendor-neutral provider, server-side only (secret).
BRANDKLIPPAREN_ASSESSMENT_generic_COMPATIBLE_API_KEY=
# Model id for the vendor-neutral provider.
BRANDKLIPPAREN_ASSESSMENT_generic_COMPATIBLE_MODEL_ID=
# API root for the vendor-neutral provider, for example ending in /v1;
# the adapter appends /chat/completions.
BRANDKLIPPAREN_ASSESSMENT_generic_COMPATIBLE_BASE_URL=
# Daily cap for vendor-neutral assessment calls.
BRANDKLIPPAREN_BUDGET_DAILY_CAP_ASSESSMENT_CALLS_generic_COMPATIBLE=
# Daily cost cap for the vendor-neutral provider.
BRANDKLIPPAREN_ASSESSMENT_DAILY_COST_CAP_generic_COMPATIBLE=
# Optional sampling temperature in [0, 1] for the vendor-neutral provider.
# When unset, the request sends no sampling parameter at all (neither
# temperature nor top_p).
BRANDKLIPPAREN_ASSESSMENT_generic_COMPATIBLE_TEMPERATURE=
# Optional completion budget for the vendor-neutral provider (bounded
# integer, default 4096 so a thinking model is not cut off).
BRANDKLIPPAREN_ASSESSMENT_generic_COMPATIBLE_MAX_TOKENS=
# Experimental AI personalize toggle (opt-in, off by default).
# Unset or "off" leaves the feature disabled with zero provider calls;
# "meta-model-api" or "generic-compatible" selects the mapping adapter
# (hosted-open-weights stays unwired). Each wired adapter reuses its
# assessment connection settings above, so no second key or endpoint
# travels beside this variable. The demo defaults to "meta-model-api"
# when a Meta key is configured (BRANDKLIPPAREN_ASSESSMENT_META_API_KEY
# or its *_FILE indirection) unless this variable is set explicitly;
# "generic-compatible" stays selectable with the assessment
# generic-compatible key, model id and base URL (the key arrives via
# BRANDKLIPPAREN_ASSESSMENT_generic_COMPATIBLE_API_KEY or its *_FILE
# indirection).
BRANDKLIPPAREN_PERSONALIZE_PROVIDER=
# Daily cap for personalize mapping calls per API key (demo with personalize).
BRANDKLIPPAREN_PERSONALIZE_DAILY_CAP_PER_KEY=
# Investigation loop on open weights (S-073, opt-in, off by default).
# An unset triple leaves the loop answering not-configured with zero calls.
# Allowlisted API root for the investigation deployment (demo with hosted),
# for example ending in /v1; the adapter appends /chat/completions.
BRANDKLIPPAREN_INVESTIGATE_hosted_BASE_URL=
# Key for the investigation deployment, server-side only (secret, demo).
BRANDKLIPPAREN_INVESTIGATE_hosted_API_KEY=
# Model id for the investigation loop (demo default: meta-models/muse-spark-open-1026).
BRANDKLIPPAREN_INVESTIGATE_hosted_MODEL_ID=
# Wall-clock budget per investigation in milliseconds (demo).
BRANDKLIPPAREN_INVESTIGATE_DEADLINE_MS=
# Input size budget per investigation call in bytes (demo).
BRANDKLIPPAREN_INVESTIGATE_MAX_INPUT_BYTES=
# Output size budget per investigation call in bytes (demo).
BRANDKLIPPAREN_INVESTIGATE_MAX_OUTPUT_BYTES=
# Step budget per investigation (demo).
BRANDKLIPPAREN_INVESTIGATE_MAX_STEPS=
# Token budget per investigation (demo).
BRANDKLIPPAREN_INVESTIGATE_MAX_TOKENS=
# Per-tool deadline per investigation in milliseconds (demo).
BRANDKLIPPAREN_INVESTIGATE_TOOL_TIMEOUT_MS=
# Prompt version for the investigation cache key (demo).
BRANDKLIPPAREN_INVESTIGATE_PROMPT_VERSION=
# Daily cap for investigations per API key (demo).
BRANDKLIPPAREN_INVESTIGATE_DAILY_CAP_PER_KEY=
# New-LP-pairs feed on mainnet (S-087, S-088, opt-in, idle by default).
# An unset key or URL leaves the feed answering not-configured with zero sends.
# Free Etherscan API key for the V2 logs source, server-side only (secret).
ETHERSCAN_API_KEY=
# The key may instead be pointed to with ETHERSCAN_API_KEY_FILE
# (absolute path, or one relative to the repo root), as with
# BRANDKLIPPAREN_ASSESSMENT_generic_COMPATIBLE_API_KEY_FILE.
# Optional JSON-RPC endpoint for the eth_getLogs fallback (secret URL, may carry a key).
BRANDKLIPPAREN_FEED_RPC_URL=
# Canonical WETH address used as the WETH quote side (operator configuration).
BK_WETH_ADDRESS=
# JSON file for the feed block cursor and pending queue (optional, S-103).
BRANDKLIPPAREN_FEED_STATE_PATH=
