{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Brandklipparen REST API v1",
  "description": "Published response schema for the versioned REST API (K-023). GET and POST /v1/analyze return the assessed envelope or the no-contract outcome; every error follows the uniform error format with status, code, message and requestId (A-18). GET /health returns the health shape and is public per I-12. Success bodies are the shared application service output byte for byte, so equal input gives equal bytes in every interface (K-027). The deepening per K-101 travels in the x-deepening-status response header until it streams in a later story.",
  "anyOf": [
    { "$ref": "#/definitions/assessed" },
    { "$ref": "#/definitions/assessedWithAssessment" },
    { "$ref": "#/definitions/noContract" },
    { "$ref": "#/definitions/health" },
    { "$ref": "#/definitions/error" },
    { "$ref": "#/definitions/plugin" },
    { "$ref": "#/definitions/pluginList" }
  ],
  "definitions": {
    "assessed": {
      "type": "object",
      "required": ["kind", "target", "block", "proxy", "codeHash", "modelVersion", "artifactChecksum", "indexVersion", "templateVersion", "assessedAt", "probabilities", "score", "signals", "pluginResults", "explanation", "cantTell"],
      "properties": {
        "kind": { "const": "assessed" },
        "target": { "type": "string", "pattern": "^0x[0-9a-fA-F]{40}$" },
        "block": { "type": "integer", "minimum": 0 },
        "proxy": {
          "type": "object",
          "required": ["kind"],
          "properties": {
            "kind": { "enum": ["none", "eip1967", "uups"] }
          }
        },
        "codeHash": { "type": "string", "minLength": 1 },
        "modelVersion": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
        "artifactChecksum": { "type": "string", "minLength": 1 },
        "indexVersion": { "type": "string", "minLength": 1 },
        "templateVersion": { "type": "string", "minLength": 1 },
        "assessedAt": { "type": "integer", "minimum": 0 },
        "probabilities": {
          "type": "object",
          "required": ["rug-pull", "honeypot", "bot-pump"],
          "properties": {
            "rug-pull": { "type": "number", "minimum": 0, "maximum": 1 },
            "honeypot": { "type": "number", "minimum": 0, "maximum": 1 },
            "bot-pump": { "type": "number", "minimum": 0, "maximum": 1 }
          }
        },
        "score": { "type": "integer", "minimum": 0, "maximum": 100 },
        "pluginResults": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["pluginId", "pluginVersion", "apiVersion", "outcome", "findings"],
            "properties": {
              "pluginId": { "type": "string", "minLength": 1 },
              "pluginVersion": { "type": "string", "minLength": 1 },
              "apiVersion": { "type": "string", "minLength": 1 },
              "outcome": { "enum": ["ok", "invalid-output", "threw", "input-unavailable"] },
              "findings": {
                "type": "array",
                "items": {
                  "type": "object",
                  "required": ["id", "pluginId", "title", "evidence"],
                  "properties": {
                    "id": { "type": "string", "minLength": 1 },
                    "pluginId": { "type": "string", "minLength": 1 },
                    "title": { "type": "string", "minLength": 1 },
                    "evidence": {
                      "type": "array",
                      "minItems": 1,
                      "items": {
                        "type": "object",
                        "required": ["selector", "offset"],
                        "properties": {
                          "selector": { "type": "string", "pattern": "^0x[0-9a-fA-F]{8}$" },
                          "offset": { "type": ["integer", "null"], "minimum": 0 }
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        },
        "signals": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["kind", "id", "risk", "evidence"],
            "properties": {
              "kind": { "enum": ["capability", "clone-match", "hard-to-analyze"] },
              "id": { "type": "string", "minLength": 1 },
              "risk": { "enum": ["rug-pull", "honeypot", "bot-pump"] },
              "direction": { "enum": ["raises", "lowers"] },
              "severity": { "enum": ["low", "medium", "high"] },
              "similarity": { "type": "number", "minimum": 0, "maximum": 1 },
              "group": { "type": "string" },
              "priorCount": { "type": "integer", "minimum": 0 },
              "cause": { "enum": ["timeout", "resource-limit", "decompiler-error", "obfuscated-structure"] },
              "evidence": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "object",
                  "required": ["selector", "offset"],
                  "properties": {
                    "selector": { "type": "string", "pattern": "^0x[0-9a-fA-F]{8}$" },
                    "offset": { "type": ["integer", "null"], "minimum": 0 }
                  }
                }
              }
            }
          }
        },
        "explanation": {
          "type": "object",
          "required": ["kind", "templateVersion", "claims"],
          "properties": {
            "kind": { "const": "template" },
            "templateVersion": { "type": "string", "minLength": 1 },
            "claims": {
              "type": "array",
              "items": {
                "type": "object",
                "required": ["text", "signalLinks", "temporality"],
                "properties": {
                  "text": { "type": "string" },
                  "signalLinks": { "type": "array", "minItems": 1, "items": { "type": "string" } },
                  "temporality": {
                    "type": "object",
                    "required": ["kind"],
                    "properties": {
                      "kind": { "enum": ["applies-now", "can-change"] }
                    }
                  }
                }
              }
            }
          }
        },
        "cantTell": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["question", "dataSource"],
            "properties": {
              "question": { "type": "string", "minLength": 1 },
              "dataSource": { "type": "string", "minLength": 1 }
            }
          }
        }
      }
    },
    "assessedWithAssessment": {
      "description": "On-request Muse contract assessment (K-305, K-309): the assessed envelope byte for byte plus the separate assessment field with provider and model labelling. Scores and evidence never move.",
      "allOf": [
        { "$ref": "#/definitions/assessed" },
        {
          "type": "object",
          "required": ["assessment", "assessmentFallback", "fromCache"],
          "properties": {
            "assessment": {
              "anyOf": [
                { "type": "null" },
                {
                  "type": "object",
                  "required": ["text", "provider", "modelId", "promptVersion", "explanationVersion", "claims"],
                  "properties": {
                    "text": { "type": "string", "minLength": 1 },
                    "provider": { "enum": ["meta-model-api", "hosted-open-weights"] },
                    "modelId": { "type": "string", "minLength": 1 },
                    "promptVersion": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
                    "explanationVersion": { "type": "string", "minLength": 1 },
                    "claims": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "required": ["text", "signalLinks", "temporality"],
                        "properties": {
                          "text": { "type": "string", "minLength": 1 },
                          "signalLinks": { "type": "array", "minItems": 1, "items": { "type": "string" } },
                          "temporality": {
                            "type": "object",
                            "required": ["kind"],
                            "properties": {
                              "kind": { "enum": ["applies-now", "can-change"] }
                            }
                          }
                        }
                      }
                    }
                  }
                }
              ]
            },
            "assessmentFallback": {
              "anyOf": [
                { "type": "null" },
                {
                  "type": "object",
                  "required": ["errorKind", "reason"],
                  "properties": {
                    "errorKind": {
                      "enum": ["not-requested", "timeout", "rate-limited", "invalid-output", "output-too-large", "provider-mismatch", "unavailable"]
                    },
                    "reason": { "type": "string", "minLength": 1 }
                  }
                }
              ]
            },
            "fromCache": { "type": "boolean" }
          }
        }
      ]
    },
    "noContract": {
      "type": "object",
      "required": ["kind", "target", "block"],
      "properties": {
        "kind": { "const": "no-contract" },
        "target": { "type": "string", "pattern": "^0x[0-9a-fA-F]{40}$" },
        "block": { "type": "integer", "minimum": 0 }
      }
    },
    "health": {
      "type": "object",
      "required": ["status", "apiVersion", "assessment", "costUnits"],
      "properties": {
        "status": { "const": "ok" },
        "apiVersion": { "const": "v1" },
        "assessment": {
          "anyOf": [
            {
              "type": "object",
              "required": ["provider", "modelId"],
              "properties": {
                "provider": { "enum": ["meta-model-api", "hosted-open-weights"] },
                "modelId": { "type": "string", "minLength": 1 }
              }
            },
            {
              "type": "object",
              "required": ["disabled"],
              "properties": {
                "disabled": { "const": true }
              }
            }
          ]
        },
        "costUnits": { "const": "placeholder-cost-unit" }
      }
    },
    "error": {
      "type": "object",
      "required": ["status", "code", "message", "requestId"],
      "properties": {
        "status": { "type": "integer", "minimum": 400, "maximum": 599 },
        "code": { "type": "string", "minLength": 1 },
        "message": { "type": "string", "minLength": 1 },
        "requestId": { "type": "string", "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$" }
      }
    },
    "plugin": {
      "type": "object",
      "required": ["id", "version", "apiVersion", "kind", "displayName", "description", "inputs", "capabilities", "outputSchema", "limits", "enabled"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "version": { "type": "string", "minLength": 1 },
        "apiVersion": { "type": "string", "minLength": 1 },
        "kind": { "enum": ["detector", "assessment"] },
        "displayName": { "type": "string", "minLength": 1 },
        "description": { "type": "string", "minLength": 1 },
        "inputs": { "type": "array", "items": { "type": "string", "minLength": 1 } },
        "capabilities": {
          "type": "object",
          "required": ["needsNetwork", "needsSecrets", "affectsScore", "runsInFastPath"],
          "properties": {
            "needsNetwork": { "type": "boolean" },
            "needsSecrets": { "type": "boolean" },
            "affectsScore": { "type": "boolean" },
            "runsInFastPath": { "type": "boolean" }
          }
        },
        "outputSchema": { "type": "object" },
        "limits": {
          "type": "object",
          "required": ["maxFindings", "maxEvidencePerFinding", "maxOutputBytes"],
          "properties": {
            "maxFindings": { "type": "integer", "minimum": 1 },
            "maxEvidencePerFinding": { "type": "integer", "minimum": 1 },
            "maxOutputBytes": { "type": "integer", "minimum": 1 }
          }
        },
        "enabled": { "const": true },
        "weight": { "type": "number", "minimum": 0 },
        "active": { "const": false }
      }
    },
    "pluginList": {
      "type": "object",
      "required": ["plugins"],
      "properties": {
        "plugins": { "type": "array", "items": { "$ref": "#/definitions/plugin" } }
      }
    }
  }
}
