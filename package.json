{
  "name": "brandklipparen",
  "version": "0.1.0",
  "description": "Brandklipparen assesses risk of newly deployed ERC-20 tokens from contract bytecode alone.",
  "type": "module",
  "engines": {
    "node": ">=22 <23"
  },
  "scripts": {
    "freeze-artifact": "node --experimental-strip-types scripts/freeze-artifact.ts",
    "evaluate-metrics": "node --experimental-strip-types scripts/evaluate-metrics.ts",
    "generate:explanations": "node --experimental-strip-types scripts/generate-web-explanations.ts",
    "smoke:real": "node --experimental-strip-types scripts/smoke-real-tokens.ts",
    "audit:plugins": "node --experimental-strip-types scripts/plugin-audit.ts --all",
    "feed:once": "node --experimental-strip-types scripts/feed-once.ts",
    "check": "npm run lint && npm run gate && npm run check:vendors && npm run check:english && npm run typecheck && npm test",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "typecheck:web": "npm --prefix apps/web run typecheck",
    "test:web": "npm --prefix apps/web test",
    "e2e:web": "npm --prefix apps/web run e2e",
    "build:web": "npm --prefix apps/web run build",
    "lint": "eslint .",
    "start:rest": "node --experimental-strip-types src/main.ts rest",
    "start:mcp": "node --experimental-strip-types src/main.ts mcp",
    "demo": "node --experimental-strip-types scripts/demo.ts",
    "gate": "depcruise --validate .dependency-cruiser.cjs src apps",
    "check:vendors": "node scripts/check-vendor-names.mjs",
    "check:english": "node scripts/check-english.mjs"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "ajv": "8.20.0",
    "dependency-cruiser": "17.4.3",
    "eslint": "9.39.5",
    "fast-check": "4.10.2",
    "typescript": "5.9.3",
    "typescript-eslint": "8.72.1",
    "vitest": "3.2.7"
  },
  "dependencies": {
    "fastify": "5.12.7"
  }
}
